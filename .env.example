DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=home_hunter_dev
POSTGRES_USER=home_hunter
POSTGRES_PASSWORD=home_hunter
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional locally; Docker always uses the shared VPS tunnel, with no direct fallback.
AVITO_PROXY_URL=
# Keep locally; scheduled Docker runs use a fresh profile, preserving request cooldowns.
AVITO_PERSISTENT_PROFILE=true
AVITO_FAST_SCAN_PAGES=1
AVITO_MAX_PAGES=50
AVITO_NO_NEW_PAGES_LIMIT=2
AVITO_PAGE_DELAY_SECONDS=120
AVITO_BLOCK_COOLDOWN_SECONDS=3600
AVITO_FULL_SCAN_ENABLED=false
# Optional local override; Docker uses /app/.avito-state in a persistent volume.
# AVITO_STATE_DIR=/absolute/path/to/avito-state
# Local only. In production set COMPOSE_FILE=docker-compose.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# CIAN uses a mandatory explicit proxy; Docker sets its internal address.
CIAN_PROXY_URL=socks5://127.0.0.1:19082
CIAN_FAST_SCAN_PAGES=1
CIAN_MAX_PAGES=50
CIAN_PAGE_DELAY_MIN_SECONDS=90
CIAN_PAGE_DELAY_MAX_SECONDS=210
CIAN_FULL_BATCH_PAGES=2
CIAN_BLOCK_COOLDOWN_SECONDS=3600
CIAN_FULL_SCAN_ENABLED=false
CIAN_SSH_DESTINATION=cian-tunnel@81.19.139.155
CIAN_SSH_DIR=/etc/home-hunter/cian-ssh

# Domclick uses Chromium because the search results are rendered client-side.
DOMCLICK_FAST_SCAN_PAGES=1
DOMCLICK_PROXY_URL=socks5://127.0.0.1:19082
DOMCLICK_MAX_PAGES=50
DOMCLICK_NO_NEW_PAGES_LIMIT=2
DOMCLICK_PAGE_DELAY_SECONDS=60
DOMCLICK_BLOCK_COOLDOWN_SECONDS=3600
DOMCLICK_FULL_SCAN_ENABLED=false
