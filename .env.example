DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=home_hunter_dev
POSTGRES_USER=home_hunter
POSTGRES_PASSWORD=home_hunter
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional locally; Docker always uses the shared VPS tunnel, with no direct fallback.
AVITO_PROXY_URL=
# Мобильный прокси Avito. URL должен содержать схему и порт, например
# http://proxy.example:8080 или socks5://proxy.example:1080.
MOBILE_PROXY_URL=
MOBILE_PROXY_USERNAME=
MOBILE_PROXY_PASSWORD=
MOBILE_PROXY_HEALTHCHECK_URL=https://api.ipify.org
# Generic server-proxy credentials. Leave empty until a server proxy is purchased;
# a route references this bundle through secret_ref=SERVER_PROXY.
SERVER_PROXY_URL=
SERVER_PROXY_USERNAME=
SERVER_PROXY_PASSWORD=
SERVER_PROXY_HEALTHCHECK_URL=https://api.ipify.org
# Keep locally; scheduled Docker runs use a fresh profile, preserving request cooldowns.
AVITO_PERSISTENT_PROFILE=true
AVITO_FAST_SCAN_PAGES=1
AVITO_MAX_PAGES=50
AVITO_NO_NEW_PAGES_LIMIT=2
AVITO_PAGE_DELAY_SECONDS=120
AVITO_BLOCK_COOLDOWN_SECONDS=3600
AVITO_FULL_SCAN_ENABLED=false
# SPFA: ключ хранится только в окружении; cookies SPFA сохраняются в AVITO_STATE_DIR.
# AVITO_SPFA_API_KEY=
# AVITO_SPFA_BASE_URL=https://spfa.pro/api
# Интервал между платными cookies/unblock-запросами SPFA (по умолчанию сутки).
AVITO_SPFA_MIN_INTERVAL_SECONDS=86400
# Optional local override; Docker uses /app/.avito-state in a persistent volume.
# AVITO_STATE_DIR=/absolute/path/to/avito-state
# Local only. In production set COMPOSE_FILE=docker-compose.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# CIAN uses a mandatory explicit proxy; Docker sets its internal address.

# Identifying User-Agent for the public Nominatim geocoder, e.g. "home-hunter/1.0 admin@example.com".
NOMINATIM_USER_AGENT=
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_BOT_USERNAME=
TG_REVIEW_USER_IDS=
# Личные chat_id для сводок full-опросов; по умолчанию используются review-пользователи.
TG_FULL_SCAN_CHAT_IDS=
TG_REVIEW_DJANGO_USERNAME=admin
TG_REVIEW_USER_MAP=
TG_POLLING_ENABLED=false
TG_POLLING_TIMEOUT=25
# Optional private/public channel chat id (usually starts with -100). The bot must be an admin.
TG_CHANNEL_ID=
TG_LISTING_ALERTS_ENABLED=false
TG_PRICE_ALERTS_ENABLED=false
TG_PRICE_ALERT_MIN_PERCENT=3
TELEGRAM_PROXY_URL=socks5://shared-socks-tunnel:1080
TG_DEAL_ALERTS_ENABLED=false
TG_DEAL_MIN_DISCOUNT_PERCENT=7
PUBLIC_BASE_URL=http://188.120.244.43
CIAN_PROXY_URL=socks5://127.0.0.1:19082
CIAN_FAST_SCAN_PAGES=1
CIAN_MAX_PAGES=50
CIAN_PAGE_DELAY_MIN_SECONDS=90
CIAN_PAGE_DELAY_MAX_SECONDS=210
CIAN_FULL_BATCH_PAGES=2
CIAN_BLOCK_COOLDOWN_SECONDS=3600
CIAN_FULL_SCAN_ENABLED=false
CIAN_DETAIL_POLL_BATCH_SIZE=7
CIAN_DETAIL_POLL_DELAY_MIN_SECONDS=90
CIAN_DETAIL_POLL_DELAY_MAX_SECONDS=120
SHARED_SSH_DESTINATION=cian-tunnel@185.161.251.49
SHARED_SSH_DIR=/etc/home-hunter/cian-ssh
SHARED_PROXY_URL=socks5://shared-socks-tunnel:1080

# Domclick uses Chromium because the search results are rendered client-side.
# Prefer a public listing URL (/pokupka/... or /arenda/...) over the legacy /search route.
DOMCLICK_FAST_SCAN_PAGES=1
DOMCLICK_PROXY_URL=socks5://127.0.0.1:19082
# Keep locally for manual headed investigation; scheduled Docker runs use a fresh profile.
DOMCLICK_PERSISTENT_PROFILE=true
DOMCLICK_MAX_PAGES=50
DOMCLICK_NO_NEW_PAGES_LIMIT=2
DOMCLICK_PAGE_DELAY_SECONDS=60
DOMCLICK_BLOCK_COOLDOWN_SECONDS=3600
DOMCLICK_FULL_SCAN_ENABLED=false
DOMCLICK_AGENT_TOKEN=
DOMCLICK_AGENT_POLL_SECONDS=5
