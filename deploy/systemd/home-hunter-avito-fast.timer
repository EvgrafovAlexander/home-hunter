[Unit]
Description=Home Hunter Avito fast scan every two hours during daytime

[Timer]
# Use explicit two-hour slots: the random delay shifts each occurrence without
# creating the accidental 30-minute cadence caused by overlapping ranges.
OnCalendar=*-*-* 08:15:00
OnCalendar=*-*-* 10:15:00
OnCalendar=*-*-* 12:15:00
OnCalendar=*-*-* 14:15:00
OnCalendar=*-*-* 16:15:00
OnCalendar=*-*-* 18:15:00
OnCalendar=*-*-* 20:15:00
OnCalendar=*-*-* 22:15:00
Persistent=false
RandomizedDelaySec=10min
Unit=home-hunter-avito-fast.service

[Install]
WantedBy=timers.target
