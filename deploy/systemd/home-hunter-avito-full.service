[Unit]
Description=Home Hunter Avito full scan
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/home_hunter
ExecStart=/usr/bin/flock -n -E 75 /tmp/home-hunter-collector.lock /usr/bin/docker compose run --rm collector python manage.py collect_listings --source avito --mode full
SuccessExitStatus=75
TimeoutStartSec=3h
