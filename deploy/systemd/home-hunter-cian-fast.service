[Unit]
Description=Home Hunter CIAN fast scan through SSH proxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/home_hunter
# A detail batch begun at :55 usually releases the shared Chromium/profile
# lock around :06.  Wait for it so the single fast-page request is not lost.
ExecStart=/usr/bin/flock -w 300 -E 75 /tmp/home-hunter-cian.lock /usr/bin/docker compose --profile cian run --no-deps --rm cian-collector
SuccessExitStatus=75
TimeoutStartSec=30min
