[Unit]
Description=Home Hunter CIAN daytime hourly fast scan

[Timer]
# Start early in the hour and let the service wait briefly for a preceding
# detail batch, rather than relying on timer jitter to avoid it.
OnCalendar=*-*-* 08..22:02:00
RandomizedDelaySec=0
Persistent=true
Unit=home-hunter-cian-fast.service

[Install]
WantedBy=timers.target
