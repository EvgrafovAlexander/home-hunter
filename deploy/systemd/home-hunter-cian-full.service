[Unit]
Description=Home Hunter CIAN cautious full batch scan through SSH proxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/home_hunter
ExecStart=/usr/bin/flock -n -E 75 /tmp/home-hunter-collector.lock /usr/bin/docker compose --profile cian run --rm -e CIAN_FULL_SCAN_ENABLED=true cian-collector xvfb-run -a -s '-screen 0 1440x1000x24 -nolisten tcp' python manage.py collect_listings --source cian --mode full --headed
SuccessExitStatus=75
TimeoutStartSec=45min
